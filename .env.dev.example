# Секреты dev-окружения. Файл коммитится сознательно: значения заведомо
# слабые и годятся для локальной разработки и тест-среды на сервере.
# Запуск: docker compose -f docker-compose.dev.yml -p pandora-dev --env-file .env.dev up -d
# Если значения не передать, compose применит те же значения как дефолты.
SECRET_KEY=dev-secret-please-override-with-env-secret-key
POSTGRES_PASSWORD=pandora
